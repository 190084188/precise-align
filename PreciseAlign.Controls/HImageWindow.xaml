<UserControl x:Class="PreciseAlign.Controls.HImageWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PreciseAlign.Controls"
             xmlns:hwpf="clr-namespace:HalconDotNet;assembly=halcondotnet"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <DockPanel>
            <ToolBarTray DockPanel.Dock="Top">
                <ToolBar>
                    <Button x:Name="BtnLoad" Content="加载" ToolTip="加载图像" Click="BtnLoad_Click" />
                    <Button x:Name="BtnFit" Content="适应窗口" ToolTip="缩放至适应窗口" Click="BtnFit_Click" />
                    <Button x:Name="BtnClear" Content="清空" ToolTip="清空窗口" Click="BtnClear_Click" />
                    <Separator/>

                    <ToggleButton x:Name="BtnPointer" Content="选择" ToolTip="选择/编辑" IsChecked="True" Click="Tool_Click"/>
                    <ToggleButton x:Name="BtnMove" Content="移动" ToolTip="移动图像" Click="Tool_Click"/>
                    <Separator/>

                    <ToggleButton x:Name="BtnDrawRectangle1" Content="矩形" ToolTip="绘制矩形" Click="Tool_Click"/>
                    <ToggleButton x:Name="BtnDrawRectangle2" Content="方向矩形" ToolTip="绘制带角度矩形" Click="Tool_Click"/>
                    <ToggleButton x:Name="BtnDrawCircle" Content="圆形" ToolTip="绘制圆形" Click="Tool_Click"/>
                </ToolBar>
            </ToolBarTray>

            <hwpf:HSmartWindowControlWPF x:Name="HalconWindow" 
                             HMouseDown="HalconWindow_HMouseDown"
                             HMouseMove="HalconWindow_HMouseMove"
                             HMouseUp="HalconWindow_HMouseUp"/>
        </DockPanel>
    </Grid>
</UserControl>