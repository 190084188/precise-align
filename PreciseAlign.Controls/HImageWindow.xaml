<UserControl x:Class="PreciseAlign.Controls.HImageWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.expression/blend/2008" 
             xmlns:local="clr-namespace:PreciseAlign.Controls"
             xmlns:hwpf="clr-namespace:HalconDotNet;assembly=halcondotnet"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <local:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}"/>
    </UserControl.Resources>

    <Grid DataContext="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}">
        <DockPanel>
            <ToolBarTray DockPanel.Dock="Top">
                <ToolBar>
                    <Button x:Name="BtnLoad" Content="加载" ToolTip="加载图像" 
                            Command="{Binding ViewModel.LoadImageCommand}" />
                    <Button x:Name="BtnFit" Content="适应窗口" ToolTip="缩放至适应窗口" 
                            Command="{Binding ViewModel.FitImageCommand}" />
                    <Button x:Name="BtnClear" Content="清空" ToolTip="清空窗口" 
                            Command="{Binding ViewModel.ClearGraphicsCommand}" />
                    <Separator/>

                    <RadioButton x:Name="BtnSelectionMode" Content="框选" ToolTip="进入对象选择模式" 
                                 GroupName="{Binding UniqueGroupName}" IsChecked="{Binding ViewModel.ActiveTool, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static local:ActiveToolMode.Selection}}"/>

                    <RadioButton x:Name="BtnMovingMode" Content="移动" ToolTip="进入图像移动模式" 
                                 GroupName="{Binding UniqueGroupName}" IsChecked="{Binding ViewModel.ActiveTool, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static local:ActiveToolMode.Moving}}"/>

                    <Separator/>
                    <RadioButton x:Name="BtnDrawRectangle1" Content="矩形" ToolTip="绘制矩形" 
                                 GroupName="{Binding UniqueGroupName}" IsChecked="{Binding ViewModel.ActiveTool, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static local:ActiveToolMode.DrawRectangle1}}"/>

                    <RadioButton x:Name="BtnDrawRectangle2" Content="方向矩形" ToolTip="绘制带角度矩形" 
                                 GroupName="{Binding UniqueGroupName}" IsChecked="{Binding ViewModel.ActiveTool, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static local:ActiveToolMode.DrawRectangle2}}"/>

                    <RadioButton x:Name="BtnDrawCircle" Content="圆形" ToolTip="绘制圆形" 
                                 GroupName="{Binding UniqueGroupName}" IsChecked="{Binding ViewModel.ActiveTool, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static local:ActiveToolMode.DrawCircle}}"/>

                </ToolBar>
            </ToolBarTray>

            <hwpf:HSmartWindowControlWPF x:Name="HalconWindow" 
                                         HMouseDown="HalconWindow_HMouseDown"
                                         HMouseMove="HalconWindow_HMouseMove"
                                         HMouseUp="HalconWindow_HMouseUp"
                                         HMouseDoubleClick="HalconWindow_HMouseDoubleClick"/>
        </DockPanel>
    </Grid>
</UserControl>